# Copy to .env (git-ignored) and fill in from Supabase → Project Settings → API.
# The anon key is designed to ship to the browser; RLS is what protects the data.
# NEVER put the service_role key in any VITE_ variable — Vite bundles those into the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
